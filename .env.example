# Copy to .env (never commit .env)
BONETWIN_ENGINE=stub                 # stub | <any engine registered in twin_core>
BONETWIN_DATABASE_URL=sqlite:///./data/runtime/app.db
BONETWIN_CORS_ORIGINS=["http://localhost:5173"]
BONETWIN_SERVE_WEB=false             # true in Docker: API also serves apps/web/dist
