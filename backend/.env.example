# AstroHealth AI backend - PostgreSQL setup
# The backend loads .env from the repository root (see backend/database.py: ENV_FILE).
# Copy the variables below into your repository-root .env (never commit .env):
#
#   copy backend\.env.example .env
#
# The repository-root .env may also contain the BONETWIN_* variables documented
# in the root .env.example used by the platform services.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=astrohealth_ai
